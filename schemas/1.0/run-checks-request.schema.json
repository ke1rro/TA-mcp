{
  "$defs": {
    "AssignmentDocument": {
      "additionalProperties": false,
      "description": "Original assignment text and immutable provenance.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "format": {
          "default": "markdown",
          "enum": [
            "markdown",
            "text"
          ],
          "title": "Format",
          "type": "string"
        },
        "id": {
          "description": "Stable entity identifier",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "original_text": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Original Text",
          "type": "string"
        },
        "provenance": {
          "default": "user-supplied assignment",
          "maxLength": 12000,
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "original_text",
        "sha256"
      ],
      "title": "AssignmentDocument",
      "type": "object"
    },
    "AssignmentRequirement": {
      "additionalProperties": false,
      "description": "Atomic requirement grounded in an exact assignment quote.",
      "properties": {
        "ambiguity_state": {
          "default": "clear",
          "enum": [
            "clear",
            "ambiguous",
            "conflicting"
          ],
          "title": "Ambiguity State",
          "type": "string"
        },
        "assignment_id": {
          "format": "uuid",
          "title": "Assignment Id",
          "type": "string"
        },
        "code": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "id": {
          "description": "Stable entity identifier",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "functional",
          "enum": [
            "functional",
            "quality",
            "constraint",
            "scoring"
          ],
          "title": "Kind",
          "type": "string"
        },
        "necessity": {
          "default": "mandatory",
          "enum": [
            "mandatory",
            "optional"
          ],
          "title": "Necessity",
          "type": "string"
        },
        "points": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "decimal_places": 4,
              "ge": 0,
              "max_digits": 16
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Points"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceSpan"
        },
        "source_quote": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Source Quote",
          "type": "string"
        },
        "text": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "assignment_id",
        "code",
        "text",
        "source",
        "source_quote"
      ],
      "title": "AssignmentRequirement",
      "type": "object"
    },
    "CriterionRequirementRef": {
      "additionalProperties": false,
      "description": "Many-to-many source binding for a criterion.",
      "properties": {
        "criterion_id": {
          "format": "uuid",
          "title": "Criterion Id",
          "type": "string"
        },
        "requirement_id": {
          "format": "uuid",
          "title": "Requirement Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "requirement_id"
      ],
      "title": "CriterionRequirementRef",
      "type": "object"
    },
    "CriterionRole": {
      "description": "Core, bonus, or qualitative criterion purpose.",
      "enum": [
        "CORE",
        "BONUS",
        "ADVISORY"
      ],
      "title": "CriterionRole",
      "type": "string"
    },
    "GradingPolicy": {
      "additionalProperties": false,
      "description": "Analysis preferences independent of source-defined point weights.",
      "properties": {
        "check_code_quality": {
          "default": true,
          "title": "Check Code Quality",
          "type": "boolean"
        },
        "check_correctness": {
          "default": true,
          "title": "Check Correctness",
          "type": "boolean"
        },
        "check_memory_safety": {
          "default": false,
          "title": "Check Memory Safety",
          "type": "boolean"
        },
        "check_requirements": {
          "default": true,
          "title": "Check Requirements",
          "type": "boolean"
        },
        "code_style": {
          "default": "none",
          "enum": [
            "none",
            "google",
            "llvm",
            "custom"
          ],
          "title": "Code Style",
          "type": "string"
        },
        "custom_style_rules": {
          "anyOf": [
            {
              "maxLength": 12000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Style Rules"
        },
        "feedback_detail": {
          "default": "detailed",
          "enum": [
            "brief",
            "detailed",
            "educational"
          ],
          "title": "Feedback Detail",
          "type": "string"
        },
        "id": {
          "description": "Stable entity identifier",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "max_score": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "decimal_places": 4,
              "ge": 0,
              "max_digits": 16
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Score"
        },
        "run_tests": {
          "default": true,
          "title": "Run Tests",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "strictness": {
          "default": "balanced",
          "enum": [
            "lenient",
            "balanced",
            "strict"
          ],
          "title": "Strictness",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "title": "GradingPolicy",
      "type": "object"
    },
    "GradingRubric": {
      "additionalProperties": false,
      "description": "Frozen source-derived allocation and explicit bonus/cap policy.",
      "properties": {
        "assignment_id": {
          "format": "uuid",
          "title": "Assignment Id",
          "type": "string"
        },
        "bonus_policy": {
          "default": "NONE",
          "enum": [
            "NONE",
            "ADD"
          ],
          "title": "Bonus Policy",
          "type": "string"
        },
        "grade_cap": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "decimal_places": 4,
              "ge": 0,
              "max_digits": 16
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grade Cap"
        },
        "grade_cap_requirement_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grade Cap Requirement Id"
        },
        "id": {
          "description": "Stable entity identifier",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "maximum_base_points": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "decimal_places": 4,
              "ge": 0,
              "max_digits": 16
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Base Points"
        },
        "needs_clarification": {
          "default": false,
          "title": "Needs Clarification",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scoring_mode": {
          "$ref": "#/$defs/ScoringMode",
          "default": "UNSCORED"
        },
        "status": {
          "const": "FROZEN",
          "default": "FROZEN",
          "title": "Status",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "assignment_id"
      ],
      "title": "GradingRubric",
      "type": "object"
    },
    "PenaltyRule": {
      "additionalProperties": false,
      "description": "Explicitly sourced, once-per-run deduction rule.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 4,
          "ge": 0,
          "max_digits": 16,
          "title": "Amount"
        },
        "code": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "description": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "description": "Stable entity identifier",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "repeat_policy": {
          "const": "ONCE",
          "default": "ONCE",
          "title": "Repeat Policy",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "rubric_id": {
          "format": "uuid",
          "title": "Rubric Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "trigger": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "rubric_id",
        "code",
        "description",
        "amount",
        "trigger",
        "requirement_ids"
      ],
      "title": "PenaltyRule",
      "type": "object"
    },
    "RubricAnalysis": {
      "additionalProperties": false,
      "description": "Structured Requirements Analyst handoff with normalized references.",
      "properties": {
        "criteria": {
          "items": {
            "$ref": "#/$defs/RubricCriterion"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "criterion_requirements": {
          "items": {
            "$ref": "#/$defs/CriterionRequirementRef"
          },
          "maxItems": 40000,
          "title": "Criterion Requirements",
          "type": "array"
        },
        "penalty_rules": {
          "items": {
            "$ref": "#/$defs/PenaltyRule"
          },
          "maxItems": 50,
          "title": "Penalty Rules",
          "type": "array"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/AssignmentRequirement"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Requirements",
          "type": "array"
        },
        "rubric": {
          "$ref": "#/$defs/GradingRubric"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "requirements",
        "rubric",
        "criteria",
        "criterion_requirements"
      ],
      "title": "RubricAnalysis",
      "type": "object"
    },
    "RubricCriterion": {
      "additionalProperties": false,
      "description": "Independently assessable rubric item.",
      "properties": {
        "category": {
          "enum": [
            "correctness",
            "requirements",
            "quality",
            "memory",
            "tests"
          ],
          "title": "Category",
          "type": "string"
        },
        "code": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "description": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "description": "Stable entity identifier",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "max_points": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "decimal_places": 4,
              "ge": 0,
              "max_digits": 16
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Points"
        },
        "ordinal": {
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/CriterionRole",
          "default": "CORE"
        },
        "rubric_id": {
          "format": "uuid",
          "title": "Rubric Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "verification_method": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Verification Method",
          "type": "string"
        }
      },
      "required": [
        "rubric_id",
        "code",
        "ordinal",
        "title",
        "description",
        "category",
        "verification_method"
      ],
      "title": "RubricCriterion",
      "type": "object"
    },
    "ScoringMode": {
      "description": "Authorized scoring modes.",
      "enum": [
        "UNSCORED",
        "POINTS"
      ],
      "title": "ScoringMode",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "Inclusive line span in an assignment or source file.",
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Freeze trusted review inputs before collecting actual check results.",
  "properties": {
    "analysis": {
      "$ref": "#/$defs/RubricAnalysis"
    },
    "archive_path": {
      "title": "Archive Path",
      "type": "string"
    },
    "assignment": {
      "$ref": "#/$defs/AssignmentDocument"
    },
    "policy": {
      "$ref": "#/$defs/GradingPolicy"
    },
    "review_run_id": {
      "format": "uuid",
      "title": "Review Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "review_run_id",
    "archive_path",
    "assignment",
    "analysis",
    "policy"
  ],
  "title": "RunChecksRequest",
  "type": "object"
}
