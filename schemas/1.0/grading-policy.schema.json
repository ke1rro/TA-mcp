{
  "additionalProperties": false,
  "description": "Analysis preferences independent of source-defined point weights.",
  "properties": {
    "check_code_quality": {
      "default": true,
      "title": "Check Code Quality",
      "type": "boolean"
    },
    "check_correctness": {
      "default": true,
      "title": "Check Correctness",
      "type": "boolean"
    },
    "check_memory_safety": {
      "default": false,
      "title": "Check Memory Safety",
      "type": "boolean"
    },
    "check_requirements": {
      "default": true,
      "title": "Check Requirements",
      "type": "boolean"
    },
    "code_style": {
      "default": "none",
      "enum": [
        "none",
        "google",
        "llvm",
        "custom"
      ],
      "title": "Code Style",
      "type": "string"
    },
    "custom_style_rules": {
      "anyOf": [
        {
          "maxLength": 12000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Custom Style Rules"
    },
    "feedback_detail": {
      "default": "detailed",
      "enum": [
        "brief",
        "detailed",
        "educational"
      ],
      "title": "Feedback Detail",
      "type": "string"
    },
    "id": {
      "description": "Stable entity identifier",
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "max_score": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 4,
          "ge": 0,
          "max_digits": 16
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Score"
    },
    "run_tests": {
      "default": true,
      "title": "Run Tests",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "strictness": {
      "default": "balanced",
      "enum": [
        "lenient",
        "balanced",
        "strict"
      ],
      "title": "Strictness",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "title": "GradingPolicy",
  "type": "object"
}
