{
  "$defs": {
    "ArchiveInspection": {
      "additionalProperties": false,
      "description": "Read-only archive manifest and requested text previews.",
      "properties": {
        "build_systems": {
          "items": {
            "type": "string"
          },
          "title": "Build Systems",
          "type": "array"
        },
        "contents": {
          "items": {
            "$ref": "#/$defs/FileContent"
          },
          "maxItems": 1000,
          "title": "Contents",
          "type": "array"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/SubmissionFile"
          },
          "maxItems": 1000,
          "title": "Files",
          "type": "array"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "submission": {
          "$ref": "#/$defs/SubmissionArchive"
        }
      },
      "required": [
        "submission",
        "files"
      ],
      "title": "ArchiveInspection",
      "type": "object"
    },
    "FileContent": {
      "additionalProperties": false,
      "description": "Bounded UTF-8 content returned by archive inspection.",
      "properties": {
        "is_truncated": {
          "default": false,
          "title": "Is Truncated",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "submission_file_id": {
          "format": "uuid",
          "title": "Submission File Id",
          "type": "string"
        },
        "text": {
          "maxLength": 65536,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "submission_file_id",
        "text"
      ],
      "title": "FileContent",
      "type": "object"
    },
    "SubmissionArchive": {
      "additionalProperties": false,
      "description": "Immutable archive metadata without student identity.",
      "properties": {
        "archive_name": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Archive Name",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "description": "Stable entity identifier",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "archive_name",
        "sha256",
        "byte_size"
      ],
      "title": "SubmissionArchive",
      "type": "object"
    },
    "SubmissionFile": {
      "additionalProperties": false,
      "description": "Canonical manifest entry in exactly one archive.",
      "properties": {
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "id": {
          "description": "Stable entity identifier",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "line_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Count"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "submission_id": {
          "format": "uuid",
          "title": "Submission Id",
          "type": "string"
        }
      },
      "required": [
        "submission_id",
        "relative_path",
        "sha256",
        "byte_size"
      ],
      "title": "SubmissionFile",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "description": "Machine-actionable boundary failure without an implementation traceback.",
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "UNSAFE_ARCHIVE",
            "CONFLICT",
            "UNAVAILABLE",
            "IO_ERROR",
            "FORBIDDEN"
          ],
          "title": "Code",
          "type": "string"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "message": {
          "maxLength": 4000,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ToolError",
      "type": "object"
    },
    "ToolFailure": {
      "additionalProperties": false,
      "description": "Discriminated MCP failure result.",
      "properties": {
        "error": {
          "$ref": "#/$defs/ToolError"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "error",
          "default": "error",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "title": "ToolFailure",
      "type": "object"
    },
    "ToolSuccess_ArchiveInspection_": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "default": "ok",
          "title": "Status",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ArchiveInspection"
        }
      },
      "required": [
        "value"
      ],
      "title": "ToolSuccess[ArchiveInspection]",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "error": "#/$defs/ToolFailure",
      "ok": "#/$defs/ToolSuccess_ArchiveInspection_"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ToolSuccess_ArchiveInspection_"
    },
    {
      "$ref": "#/$defs/ToolFailure"
    }
  ]
}
