{
  "$defs": {
    "ReviewPaths": {
      "additionalProperties": false,
      "description": "Finalized outputs from the only persistent-state MCP operation.",
      "properties": {
        "content_digest": {
          "title": "Content Digest",
          "type": "string"
        },
        "is_complete": {
          "const": true,
          "default": true,
          "title": "Is Complete",
          "type": "boolean"
        },
        "json_path": {
          "title": "Json Path",
          "type": "string"
        },
        "markdown_path": {
          "title": "Markdown Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "json_path",
        "markdown_path",
        "content_digest"
      ],
      "title": "ReviewPaths",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "description": "Machine-actionable boundary failure without an implementation traceback.",
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "UNSAFE_ARCHIVE",
            "CONFLICT",
            "UNAVAILABLE",
            "IO_ERROR",
            "FORBIDDEN"
          ],
          "title": "Code",
          "type": "string"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "message": {
          "maxLength": 4000,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ToolError",
      "type": "object"
    },
    "ToolFailure": {
      "additionalProperties": false,
      "description": "Discriminated MCP failure result.",
      "properties": {
        "error": {
          "$ref": "#/$defs/ToolError"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "error",
          "default": "error",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "title": "ToolFailure",
      "type": "object"
    },
    "ToolSuccess_ReviewPaths_": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "default": "ok",
          "title": "Status",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ReviewPaths"
        }
      },
      "required": [
        "value"
      ],
      "title": "ToolSuccess[ReviewPaths]",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "error": "#/$defs/ToolFailure",
      "ok": "#/$defs/ToolSuccess_ReviewPaths_"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ToolSuccess_ReviewPaths_"
    },
    {
      "$ref": "#/$defs/ToolFailure"
    }
  ]
}
