{
  "$defs": {
    "CheckExecution": {
      "additionalProperties": false,
      "description": "Actual bounded tool result, including nonexecution reasons.",
      "properties": {
        "bounded_stderr": {
          "default": "",
          "maxLength": 16000,
          "title": "Bounded Stderr",
          "type": "string"
        },
        "bounded_stdout": {
          "default": "",
          "maxLength": 16000,
          "title": "Bounded Stdout",
          "type": "string"
        },
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "environment_digest": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Environment Digest",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "id": {
          "description": "Stable entity identifier",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "compile",
            "tests",
            "static",
            "memory"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 12000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "review_run_id": {
          "format": "uuid",
          "title": "Review Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        },
        "tool_name": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "review_run_id",
        "kind",
        "status",
        "tool_name",
        "environment_digest"
      ],
      "title": "CheckExecution",
      "type": "object"
    },
    "CheckResults": {
      "additionalProperties": false,
      "description": "Actual executions and the frozen input digest for audit.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckExecution"
          },
          "title": "Checks",
          "type": "array"
        },
        "frozen_input_digest": {
          "title": "Frozen Input Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "checks",
        "frozen_input_digest"
      ],
      "title": "CheckResults",
      "type": "object"
    },
    "CheckStatus": {
      "description": "Execution outcomes, including unavailable environments.",
      "enum": [
        "PASSED",
        "FAILED",
        "SKIPPED",
        "UNAVAILABLE",
        "TIMEOUT",
        "ERROR"
      ],
      "title": "CheckStatus",
      "type": "string"
    },
    "ToolError": {
      "additionalProperties": false,
      "description": "Machine-actionable boundary failure without an implementation traceback.",
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "UNSAFE_ARCHIVE",
            "CONFLICT",
            "UNAVAILABLE",
            "IO_ERROR",
            "FORBIDDEN"
          ],
          "title": "Code",
          "type": "string"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "message": {
          "maxLength": 4000,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ToolError",
      "type": "object"
    },
    "ToolFailure": {
      "additionalProperties": false,
      "description": "Discriminated MCP failure result.",
      "properties": {
        "error": {
          "$ref": "#/$defs/ToolError"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "error",
          "default": "error",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "title": "ToolFailure",
      "type": "object"
    },
    "ToolSuccess_CheckResults_": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "default": "ok",
          "title": "Status",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/CheckResults"
        }
      },
      "required": [
        "value"
      ],
      "title": "ToolSuccess[CheckResults]",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "error": "#/$defs/ToolFailure",
      "ok": "#/$defs/ToolSuccess_CheckResults_"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ToolSuccess_CheckResults_"
    },
    {
      "$ref": "#/$defs/ToolFailure"
    }
  ]
}
