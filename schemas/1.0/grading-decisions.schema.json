{
  "$defs": {
    "CheckEvidence": {
      "additionalProperties": false,
      "description": "Exact diagnostic substring from a captured execution.",
      "properties": {
        "check_execution_id": {
          "format": "uuid",
          "title": "Check Execution Id",
          "type": "string"
        },
        "diagnostic": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Diagnostic",
          "type": "string"
        },
        "diagnostic_stream": {
          "enum": [
            "stdout",
            "stderr"
          ],
          "title": "Diagnostic Stream",
          "type": "string"
        },
        "end_offset": {
          "exclusiveMinimum": 0,
          "title": "End Offset",
          "type": "integer"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "id": {
          "description": "Stable entity identifier",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "check",
          "default": "check",
          "title": "Kind",
          "type": "string"
        },
        "review_run_id": {
          "format": "uuid",
          "title": "Review Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_offset": {
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        },
        "summary": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "review_run_id",
        "summary",
        "check_execution_id",
        "diagnostic_stream",
        "start_offset",
        "end_offset",
        "diagnostic",
        "exit_code"
      ],
      "title": "CheckEvidence",
      "type": "object"
    },
    "CriterionAssessment": {
      "additionalProperties": false,
      "description": "Evidence-linked decision for exactly one rubric criterion.",
      "properties": {
        "awarded_points": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "decimal_places": 4,
              "ge": 0,
              "max_digits": 16
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Awarded Points"
        },
        "criterion_id": {
          "format": "uuid",
          "title": "Criterion Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Evidence Ids",
          "type": "array"
        },
        "explanation": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "id": {
          "description": "Stable entity identifier",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "not_verifiable_reason": {
          "anyOf": [
            {
              "maxLength": 12000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Verifiable Reason"
        },
        "recommendations": {
          "default": "",
          "maxLength": 12000,
          "title": "Recommendations",
          "type": "string"
        },
        "review_run_id": {
          "format": "uuid",
          "title": "Review Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CriterionStatus"
        }
      },
      "required": [
        "review_run_id",
        "criterion_id",
        "status",
        "explanation"
      ],
      "title": "CriterionAssessment",
      "type": "object"
    },
    "CriterionStatus": {
      "description": "Assessment truth states.",
      "enum": [
        "PASS",
        "PARTIAL",
        "FAIL",
        "NOT_VERIFIABLE"
      ],
      "title": "CriterionStatus",
      "type": "string"
    },
    "ObservationEvidence": {
      "additionalProperties": false,
      "description": "Manifest-observable fact, never an invented execution claim.",
      "properties": {
        "id": {
          "description": "Stable entity identifier",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "observation",
          "default": "observation",
          "title": "Kind",
          "type": "string"
        },
        "observation": {
          "enum": [
            "file_absent",
            "file_present"
          ],
          "title": "Observation",
          "type": "string"
        },
        "provenance_description": {
          "const": "inspected archive manifest",
          "default": "inspected archive manifest",
          "title": "Provenance Description",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "review_run_id": {
          "format": "uuid",
          "title": "Review Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "review_run_id",
        "summary",
        "observation",
        "relative_path"
      ],
      "title": "ObservationEvidence",
      "type": "object"
    },
    "PenaltyApplication": {
      "additionalProperties": false,
      "description": "One evidence-backed use of an authorized deduction rule.",
      "properties": {
        "applied_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 4,
          "ge": 0,
          "max_digits": 16,
          "title": "Applied Amount"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "explanation": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "id": {
          "description": "Stable entity identifier",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "penalty_rule_id": {
          "format": "uuid",
          "title": "Penalty Rule Id",
          "type": "string"
        },
        "review_run_id": {
          "format": "uuid",
          "title": "Review Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "review_run_id",
        "penalty_rule_id",
        "applied_amount",
        "explanation",
        "evidence_ids"
      ],
      "title": "PenaltyApplication",
      "type": "object"
    },
    "SourceFileEvidence": {
      "additionalProperties": false,
      "description": "Exact inspected source excerpt supporting an assessment.",
      "properties": {
        "id": {
          "description": "Stable entity identifier",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "source",
          "default": "source",
          "title": "Kind",
          "type": "string"
        },
        "review_run_id": {
          "format": "uuid",
          "title": "Review Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "submission_file_id": {
          "format": "uuid",
          "title": "Submission File Id",
          "type": "string"
        },
        "summary": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "verified_excerpt": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Verified Excerpt",
          "type": "string"
        }
      },
      "required": [
        "review_run_id",
        "summary",
        "submission_file_id",
        "span",
        "verified_excerpt"
      ],
      "title": "SourceFileEvidence",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "Inclusive line span in an assignment or source file.",
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Structured Submission Grader output without trusted totals.",
  "properties": {
    "assessments": {
      "items": {
        "$ref": "#/$defs/CriterionAssessment"
      },
      "maxItems": 200,
      "title": "Assessments",
      "type": "array"
    },
    "evidence": {
      "items": {
        "discriminator": {
          "mapping": {
            "check": "#/$defs/CheckEvidence",
            "observation": "#/$defs/ObservationEvidence",
            "source": "#/$defs/SourceFileEvidence"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SourceFileEvidence"
          },
          {
            "$ref": "#/$defs/CheckEvidence"
          },
          {
            "$ref": "#/$defs/ObservationEvidence"
          }
        ]
      },
      "maxItems": 1000,
      "title": "Evidence",
      "type": "array"
    },
    "penalty_applications": {
      "items": {
        "$ref": "#/$defs/PenaltyApplication"
      },
      "maxItems": 50,
      "title": "Penalty Applications",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "assessments"
  ],
  "title": "GradingDecisions",
  "type": "object"
}
